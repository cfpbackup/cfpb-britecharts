
{
    "source": {
        "include": ["src/charts"],
        "includePattern": ".+\\.js(doc|x)?$",
        "excludePattern": "(^|\\/|\\\\)_"
    },
    "opts": {
        "template": "node_modules/docdash",
        "encoding": "utf8",
        "destination": "./docs",
        "recurse": true,
        "readme": "README.md",
        "tutorials": "src/doc/tutorials"
    },
    "docdash": {
        "static": true,
        "sort": true,
        "search": true,
        "collapse": true,
        "wrap": true,
        "typedefs": true,
        "removeQuotes": "none",
        "scripts": []
    },
    "templates": {
        "cleverLinks": false,
        "monospaceLinks": false,
        "default": {
            "outputSourceFiles": true
        }
    },
    "plugins": []
}
