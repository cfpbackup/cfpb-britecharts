{
    "name": "cfpb-britecharts",
    "version": "2.4.3",
    "description": "D3.js based Modular Charting Library by Eventbrite",
    "main": "dist/bundled/britecharts.min.js",
    "contributors": [
        {
            "name": "Marcos Iglesias",
            "email": "golodhros@gmail.com"
        },
        {
            "name": "Ryan Wholey",
            "email": "rjwholey@gmail.com"
        },
        {
            "name": "Sun Dai",
            "email": "sundaisf@gmail.com"
        },
        {
            "name": "Jaylum Chen",
            "email": "jaylum@eventbrite.com"
        },
        {
            "name": "Amber Rockwood",
            "email": "arockwood@eventbrite.com"
        },
        {
            "name": "Daler Asrorov",
            "email": "daler.asrorov@eventbrite.com"
        }
    ],
    "scripts": {
        "demos:compile": "webpack --progress --env demos",
        "demos:watch": "webpack --watch --progress --env demos",
        "demos:serve": "webpack serve --env demos",
        "start": "concurrently \"yarn run docs:watch\" \"yarn run demos:serve\" \"yarn run sandbox\"",
        "styles": "yarn run styles:lint && yarn run styles:build && yarn run styles:minify",
        "styles:build": "sass src/styles:dist/css --no-source-map && sass src/styles/britecharts.scss:demos/css/britecharts.css --no-source-map",
        "styles:minify": "postcss 'dist/css/**/*.css' --base dist/css --dir dist/css --use cssnano --no-map --ext .min.css",
        "styles:lint": "stylelint \"src/styles/**/*.scss\"",
        "styles:watch": "sass src/styles:dist/css --watch --no-source-map",
        "docs": "webpack --progress --env demos && yarn run styles && yarn run docs:build",
        "docs:build": "yarn run docs:generate && node scripts/generate-demo-pages.js && node scripts/sync-docs.js",
        "docs:generate": "NODE_NO_WARNINGS=1 jsdoc -c jsdoc.config.json",
        "docs:watch": "node scripts/watch-docs.js",
        "docs:serve": "http-server ./docs -p 8001 -c-1 -o",
        "prebuild": "yarn run styles",
        "build": "webpack --progress --env production",
        "lint": "eslint src/charts/ webpack.*.js --cache",
        "lint:fix": "eslint src/charts/ webpack.*.js --cache --fix",
        "test": "karma start --env test",
        "test:travis": "karma start --single-run --browsers ChromeHeadless --env test",
        "sandbox:compile": "webpack --progress --env sandbox",
        "sandbox": "webpack serve --env sandbox",
        "clean": "yarn cache clean && rimraf node_modules",
        "release": "yarn run release:patch",
        "release:patch": "standard-version --release-as patch",
        "release:minor": "standard-version --release-as minor",
        "release:major": "standard-version --release-as major"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/cfpb/cfpb-britecharts.git"
    },
    "keywords": [
        "d3",
        "svg",
        "chart",
        "javascript",
        "es6",
        "es2015",
        "visualizations",
        "data-visualization",
        "interactive-visualizations"
    ],
    "author": "Eventbrite",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/cfpb/cfpb-britecharts/issues"
    },
    "homepage": "http://localhost:8001/",
    "dependencies": {
        "base-64": "^1.0.0",
        "d3": "^5.16.0",
        "lodash.assign": "^4.2.0"
    },
    "resolutions": {
        "handlebars": "^4.7.8",
        "lodash": "^4.17.21",
        "minimist": "^1.2.8",
        "shell-quote": "^1.8.1",
        "deep-extend": "^0.6.0",
        "uglify-js": "^3.17.4",
        "babel-traverse": "^6.26.0",
        "@babel/traverse": "^7.23.2",
        "form-data": "^4.0.0"
    },
    "devDependencies": {
        "@babel/core": "^7.24.0",
        "@babel/preset-env": "^7.24.0",
        "babel-loader": "^9.1.3",
        "babel-plugin-istanbul": "^7.0.1",
        "brace": "^0.11.1",
        "chokidar": "^4.0.3",
        "concurrently": "^8.2.2",
        "css-loader": "^6.10.0",
        "cssnano": "^6.0.0",
        "docdash": "^2.0.2",
        "eslint": "^8.56.0",
        "fs-extra": "^11.3.2",
        "glob": "^11.0.3",
        "http-server": "^14.1.1",
        "jasmine-core": "^5.1.0",
        "jasmine-jquery": "^2.1.1",
        "jquery": "^3.7.1",
        "jsdoc": "^4.0.3",
        "karma": "^6.4.4",
        "karma-chrome-launcher": "^3.2.0",
        "karma-coverage": "^2.2.1",
        "karma-coverage-istanbul-reporter": "^3.0.3",
        "karma-jasmine": "^5.1.0",
        "karma-jasmine-jquery": "^0.1.1",
        "karma-sourcemap-loader": "^0.4.0",
        "karma-webpack": "^5.0.1",
        "moment": "^2.30.1",
        "postcss": "^8.4.49",
        "postcss-cli": "^11.0.0",
        "prismjs": "^1.30.0",
        "pubsub-js": "^1.9.3",
        "rimraf": "^5.0.5",
        "sanitize-html": "^2.13.1",
        "sass": "^1.71.0",
        "sass-loader": "^14.1.0",
        "sinon": "^17.0.1",
        "standard-version": "^9.5.0",
        "style-loader": "^3.3.4",
        "stylelint": "^16.2.0",
        "stylelint-config-standard-scss": "^13.0.0",
        "taffydb": "^2.7.3",
        "underscore": "^1.13.7",
        "webpack": "^5.90.0",
        "webpack-bundle-analyzer": "^4.10.0",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^5.2.1",
        "webpack-merge": "^5.10.0",
        "ws": "^8.16.0",
        "yargs": "^17.7.2"
    }
}
