{
    "name": "cfpb-britecharts",
    "version": "2.4.3",
    "description": "D3.js based Modular Charting Library by Eventbrite",
    "main": "dist/bundled/britecharts.min.js",
    "contributors": [
        {
            "name": "Marcos Iglesias",
            "email": "golodhros@gmail.com"
        },
        {
            "name": "Ryan Wholey",
            "email": "rjwholey@gmail.com"
        },
        {
            "name": "Sun Dai",
            "email": "sundaisf@gmail.com"
        },
        {
            "name": "Jaylum Chen",
            "email": "jaylum@eventbrite.com"
        },
        {
            "name": "Amber Rockwood",
            "email": "arockwood@eventbrite.com"
        },
        {
            "name": "Daler Asrorov",
            "email": "daler.asrorov@eventbrite.com"
        }
    ],
    "scripts": {
        "demos:compile": "webpack --progress --colors --env demos",
        "demos:watch": "webpack --watch --progress --colors --env demos",
        "demos:serve": "webpack serve --env demos",
        "start": "concurrently \"yarn run docs:watch\" \"yarn run demos:serve\" \"yarn run sandbox\"",
        "styles": "yarn run styles:lint && yarn run styles:build && yarn run styles:minify",
        "styles:build": "sass src/styles:dist/css --no-source-map && sass src/styles/britecharts.scss:demos/css/britecharts.css --no-source-map",
        "styles:minify": "postcss dist/css/**/*.css --replace --use cssnano --no-map",
        "styles:lint": "stylelint \"src/styles/**/*.scss\"",
        "styles:watch": "sass src/styles:dist/css --watch --no-source-map",
        "docs": "webpack --env demos && yarn run styles && yarn run docs:build",
        "docs:build": "yarn run docs:generate && node scripts/sync-docs.js",
        "docs:generate": "jsdoc -c jsdoc.config.json",
        "docs:watch": "node scripts/watch-docs.js",
        "docs:serve": "http-server ./docs -p 8001 -c-1 -o",
        "prebuild": "yarn run styles",
        "build": "webpack --env production",
        "lint": "eslint src/charts/ webpack.*.js --cache",
        "lint:fix": "eslint src/charts/ webpack.*.js --cache --fix",
        "test": "karma start --env test",
        "test:travis": "karma start --single-run --browsers ChromeHeadless --env test",
        "sandbox:compile": "webpack --env sandbox",
        "sandbox": "webpack serve --env sandbox",
        "clean": "yarn cache clean && rimraf node_modules",
        "release": "yarn run release:patch",
        "release:patch": "standard-version --release-as patch",
        "release:minor": "standard-version --release-as minor",
        "release:major": "standard-version --release-as major"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/cfpb/cfpb-britecharts.git"
    },
    "keywords": [
        "d3",
        "svg",
        "chart",
        "javascript",
        "es6",
        "es2015",
        "visualizations",
        "data-visualization",
        "interactive-visualizations"
    ],
    "author": "Eventbrite",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/cfpb/cfpb-britecharts/issues"
    },
    "homepage": "http://eventbrite.github.io/britecharts/",
    "dependencies": {
        "base-64": "^1.0.0",
        "d3": "^5.16.0",
        "lodash.assign": "^4.2.0"
    },
    "devDependencies": {
        "@babel/core": "^7.12.0",
        "@babel/preset-env": "^7.12.0",
        "babel-loader": "^8.2.0",
        "brace": "^0.11.1",
        "chokidar": "^4.0.3",
        "concurrently": "^6.0.0",
        "css-loader": "^5.0.0",
        "cssnano": "^6.0.0",
        "eslint": "^8.56.0",
        "fs-extra": "^11.3.2",
        "http-server": "^14.1.1",
        "ink-docstrap": "^1.3.2",
        "istanbul-instrumenter-loader": "^3.0.1",
        "jasmine-core": "^3.10.0",
        "jasmine-jquery": "^2.1.1",
        "jquery": "^3.6.0",
        "jsdoc": "^4.0.2",
        "karma": "^6.4.4",
        "karma-chrome-launcher": "^3.1.0",
        "karma-coverage": "^2.0.3",
        "karma-coverage-istanbul-reporter": "^3.0.3",
        "karma-jasmine": "^4.0.1",
        "karma-jasmine-jquery": "^0.1.1",
        "karma-sourcemap-loader": "^0.3.8",
        "karma-webpack": "^5.0.0",
        "moment": "^2.30.1",
        "postcss": "^8.4.32",
        "postcss-cli": "^11.0.0",
        "prismjs": "^1.30.0",
        "pubsub-js": "^1.9.3",
        "rimraf": "^3.0.2",
        "sanitize-html": "^2.17.0",
        "sass": "^1.69.0",
        "sass-loader": "^12.0.0",
        "sinon": "^12.0.0",
        "standard-version": "^9.5.0",
        "style-loader": "^3.0.0",
        "stylelint": "^15.11.0",
        "stylelint-config-standard-scss": "^11.1.0",
        "underscore": "^1.13.7",
        "webpack": "^5.65.0",
        "webpack-bundle-analyzer": "^4.5.0",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^5.2.1",
        "webpack-merge": "^5.8.0",
        "ws": "^8.5.0",
        "yargs": "^17.3.0"
    }
}
